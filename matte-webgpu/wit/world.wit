package ffrwd:longpipe-webgpu;

/// The matte node on the sidecar's device: the node world beside
/// `ffrwd:gpu`, which imports `wasi:webgpu` and so needs a `-gpu` grant,
/// and `ffrwd:models`, through which it reads the weights its manifest pins.
world matte {
  include ffrwd:av/node-module@0.19.1;
  include ffrwd:gpu/gpu-module@0.1.0;
  include ffrwd:models/models-module@0.1.0;
}
