{
  "name": "ffrwd/longpipe",
  "version": "0.1.0",
  "description": "Whole-frame foreground matting with longpipe's small net, hosted in wasm: one grayscale alpha matte per frame, and recipes that blur the background, replace it, or carry the picture with its alpha. Everything downstream is native ffmpeg. The model is sb2702/longpipe's work (MIT, code and weights), converted to ONNX and fetched at install.",
  "license": "MIT",
  "homepage": "https://github.com/imbcmdth/ffrwd-package-longpipe",
  "capabilities": [
    "nn"
  ],
  "dependencies": {
    "ffrwd/wasm": "0.12.0",
    "ffrwd/mask_tools": "1.0.3"
  },
  "keywords": [
    "matting",
    "matte",
    "alpha",
    "background",
    "blur",
    "greenscreen",
    "portrait",
    "nn"
  ],
  "lib": {
    "matte": "src/model.sql"
  },
  "bin": {
    "background-blur": "recipes/background-blur.sql",
    "background-replace": "recipes/background-replace.sql",
    "greenscreen": "recipes/greenscreen.sql",
    "matte": "recipes/matte.sql"
  },
  "models": {
    "matte": {
      "repo": "imbcmdth/longpipe-onnx",
      "revision": "466029f998008e59601a3f611aec40fa55ef3f93",
      "file": "matting_xl_temporal_f32.onnx",
      "sha256": "67f79a367c4014d9df631afb002c99bf6efb1aa4ae122df175b45f2f92d611b6",
      "not_on": ["directml"]
    }
  }
}
